# Copie ce fichier en .env pour le dev local (ne jamais committer .env)

# Clé API Anthropic (texte des articles)
ANTHROPIC_API_KEY=sk-ant-...

# Clé API OpenAI (génération des images d'articles, gpt-image-1)
OPENAI_API_KEY=sk-...

# Secrets de toutes les boutiques, en JSON sur une seule ligne :
# { "boutique-1": { "shopify_token": "shpat_...", "pexels_key": "..." } }
STORES_SECRETS={"boutique-1":{"shopify_token":"shpat_xxx","pexels_key":"yyy"}}

# Telegram (rapport quotidien)
TELEGRAM_BOT_TOKEN=123456:ABC...
TELEGRAM_CHAT_ID=123456789

# Images : "ai" (OpenAI gpt-image-1, défaut) ou "stock" (Pexels/Unsplash). Qualité : low|medium|high.
IMAGE_MODE=ai
IMAGE_QUALITY=medium

# Optionnel : mettre à "1" pour committer l'état via git (activé en CI)
COMMIT_STATE=0
